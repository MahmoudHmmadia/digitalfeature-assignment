# Ports exposed by Docker Compose
CLIENT_PORT=8080
SERVER_PORT=3000
MONGO_PORT=27017

# The Compose hostname is intentionally mongodb, not localhost.
DATABASE_URL=mongodb://mongodb:27017/feedbackhub?replicaSet=rs0
MODE=DEV
SECRET=replace-with-a-long-random-secret
PRISMA_DB_PUSH=true

# Public URLs used when the API returns asset links
DEV_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
IMAGES_PATH=assets/images
ASSETS_PATH=assets

# SMTP is optional in DEV because the verification code is 000000.
EMAIL=
PASSWORD=
EMAIL_FORM=

# Demo administrator created by the seed command
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin User
ADMIN_PASSWORD=change-this-admin-password
