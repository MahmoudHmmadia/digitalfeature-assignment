{
  "name": "server",
  "version": "1.0.0",
  "description": "Express server with TypeScript",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "build": "esbuild server.ts --bundle --platform=node --outfile=server.js --external:@prisma/client --external:.prisma/client",
    "db:push": "prisma db push",
    "db:seed": "bun run seeders/admin.seeder.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "migrate": "prisma db push",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "new-module": "./scripts/new-module.sh",
    "init-prisma": "prisma init",
    "test": "echo \"No server tests specified\""
  },
  "keywords": ["express", "typescript", "nodejs"],
  "author": "",
  "license": "ISC",
  "packageManager": "bun@1.3.5",
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "joi": "latest",
    "jsonwebtoken": "latest",
    "morgan": "latest",
    "multer": "latest",
    "nodemailer": "latest",
    "rotating-file-stream": "latest",
    "swagger-ui-express": "latest",
    "uuid": "latest"
  },
  "devDependencies": {
    "@types/cookie-parser": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/morgan": "latest",
    "@types/multer": "latest",
    "@types/nodemailer": "latest",
    "@types/swagger-ui-express": "latest",
    "@types/uuid": "latest",
    "esbuild": "latest",
    "prisma": "6.19.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
